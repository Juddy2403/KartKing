:root {
}

.label {
    justify-content: center;
    align-self: center;
    align-items: center;
    align-content: center;
    -unity-font-definition: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    -unity-font-style: bold;
    font-size: 32px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
}

.box {
    background-color: rgb(107, 124, 205);
    border-top-width: 2px;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-left-color: rgb(39, 35, 95);
    border-right-color: rgb(39, 35, 95);
    border-top-color: rgb(39, 35, 95);
    border-bottom-color: rgb(39, 35, 95);
}

.winner {
    background-color: rgb(133, 157, 94);
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
}
