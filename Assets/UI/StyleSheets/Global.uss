:root {
}

.text {
    color: rgb(255, 255, 255);
    font-size: 37px;
    -unity-font-style: italic;
}

.button {
    background-color: rgb(176, 102, 28);
    align-self: stretch;
    align-content: auto;
    margin-bottom: 50px;
    transition-duration: 0.3s;
}

.button:hover {
    background-color: rgb(168, 64, 64);
    transition-duration: 0.2s;
}

.button:active {
    transition-duration: 0.1s;
    scale: 0.9 0.9 0.9;
}

.button:focus {
    background-color: rgb(168, 64, 64);
    transition-duration: 0.2s;
}
